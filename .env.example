# Export these variables before starting the application; no dotenv loader.
APP_DATA_DIR=./data
# DATABASE_PATH=./data/app.db
# UPLOAD_DIR=./data/raw
# 0 removes byte quotas. There is no file-count setting.
MAX_FILE_BYTES=0
MAX_REQUEST_BYTES=0
MAX_STORAGE_BYTES=0
INSPECTION_BYTES=65536
SAMPLE_ROWS=200
SAMPLE_PAGES=3
PARSER_TIMEOUT=60
PARSER_MEMORY_MB=512
# Compose container memory; increase together with parser budgets if needed.
APP_MEMORY_LIMIT=1g
OCR_LANGUAGES=eng+chi_sim+chi_tra
WORKER_ENABLED=1
APP_ENV=development
# Production requires a unique token of at least 32 characters.
# API_TOKEN=<operator-supplied-token>
# Optional operator-owned Tika service; originals are transmitted to it only if configured.
# TIKA_URL=http://tika:9998
ARCHIVE_BYTES=1073741824
PORT=8000
