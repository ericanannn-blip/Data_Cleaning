{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dat-file-inspector",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-08",
  "d1_databases": [{"binding":"DB","database_name":"dat-file-inspector","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"dat-file-inspector-originals"}]
}
